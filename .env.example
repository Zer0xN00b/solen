# Environment for `docker compose`. Compose reads THIS file at the repo
# root (not backend/.env).
#
#   cp .env.example .env   then fill in BETTER_AUTH_SECRET
#   docker compose up --build

# REQUIRED. Generate with: openssl rand -hex 32
# Rotating it signs every existing user out.
BETTER_AUTH_SECRET=replace-with-a-long-random-string

# The public URL people visit. Must match reality exactly — Better Auth
# validates the browser Origin header against it, and a mismatch fails
# sign-in with an error that does not name the cause.
PUBLIC_URL=http://localhost:4000

# Number of reverse proxies in front of the app (usually 1 once deployed).
# Without it the rate limiter treats every visitor as one IP.
# Leave blank when running the container directly on a host port.
TRUST_PROXY=