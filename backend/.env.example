# SOLEN backend environment — copy to .env and adjust as needed
#   cp .env.example .env
#
# In Docker these are supplied by docker-compose.yml instead; see the root
# .env.example for that.

# Server
NODE_ENV=development
PORT=4000

# SQLite database file (resolved relative to backend/)
DB_FILE=./data/solen.db

# Better Auth — REQUIRED. Generate a secret with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Rotating this signs every existing user out.
BETTER_AUTH_SECRET=replace-with-a-long-random-string

# The public origin Better Auth treats as canonical. In development this is
# the API itself. In a single-origin deployment it is ALSO the frontend, and
# MUST match what the user types — a mismatch fails sign-in with an
# origin error rather than anything that names the real cause.
BETTER_AUTH_URL=http://localhost:4000

# Production only — how many reverse proxies sit in front of this process.
# Required for the rate limiter to key on the real client IP: without it every
# visitor shares the proxy's address and a burst from one of them locks out
# everyone. Usually 1. Leave empty in development.
TRUST_PROXY=

# Extra comma-separated origins to trust, for splitting frontend and API
# across hosts. Not needed for the single-container layout.
TRUSTED_ORIGINS_EXTRA=
