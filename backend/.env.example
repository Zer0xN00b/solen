# SOLEN backend environment — copy to .env and adjust as needed
#   cp .env.example .env

# Server
NODE_ENV=development
PORT=4000

# SQLite database file (resolved relative to backend/)
DB_FILE=./data/solen.db

# Better Auth — REQUIRED. Generate a secret with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:4000
